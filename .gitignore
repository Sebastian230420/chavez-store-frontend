# ═══════════════════════════════════════════════════════════
# Chavez Store — monorepo (backend Spring Boot + frontend Angular)
# ═══════════════════════════════════════════════════════════

# ─── Sistema operativo ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Secretos: nunca versionar configuración local ────────
# `application.properties` versionado trae la contraseña de MySQL de desarrollo.
# Para producción usa `application-local.properties` (ignorado) o variables de entorno.
.env
.env.*
!.env.example
*-local.properties
*-local.yaml
*-local.yml
application-local.properties
secrets.properties

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Backups y volcados de base de datos ─────────────────
*.sql.gz
*.dump
backup/
backups/
*.bak
*.old

# ─── Backend Java / Spring Boot / Maven ───────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

.mvn/wrapper/maven-wrapper.jar

