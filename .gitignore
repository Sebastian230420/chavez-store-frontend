*.orig
hs_err_pid*
replay_pid*

# ─── Frontend Angular / Node ──────────────────────────────
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/
.sass-cache/
coverage/
connect.lock
typings/
__screenshots__/
.history/
*.tsbuildinfo

# Los .gitignore por subproyecto también aplican:
# se replican aquí para que un repo plano también los respete.
frontend/.vscode/
frontend/dist/
frontend/node_modules/
frontend/.angular/

# ─── Datos locales / exportaciones generadas ─────────────
# Los patrones llevan ancla inicial "/" a propósito.
# Sin ella, "reportes/" también alcanzaría a cualquier nivel, incluido
# frontend/src/app/features/reportes/, que es CÓDIGO FUENTE y sí se versiona.
/*.csv
/reportes/
/exports/