# Normalización de finales de línea
# Evita que Git reporte "LF will be replaced by CRLF" en cada checkout en Windows.

# Por defecto: LF en el repositorio, nativo al hacer checkout
* text=auto eol=lf

# ─── Archivos que deben ser CRLF ───────────────────────────
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ─── Ejecutables con shebang: LF obligatorio ────────────────
mvnw    text eol=lf

# ─── Documentación y código: LF explícito ──────────────────
*.java       text eol=lf
*.ts         text eol=lf
*.html       text eol=lf
*.scss       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
.mvn/**      text eol=lf

# ─── Binarios: nunca tocar finales de línea ─────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.jar    binary
*.zip    binary
*.class  binary